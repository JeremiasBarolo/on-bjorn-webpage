---
import Header from "../components/shared/Header.astro";
import Footer from "../components/shared/Footer.astro";
import { site } from "../data/site";
import "../styles/global.css";
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
}
const {
  title = "ON BJORN — Soluciones digitales a medida",
  description = site.description,
  ogImage = "/images/og-on-bjorn.jpg",
  canonical,
  noindex = false,
  schema,
} = Astro.props;
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, site.url).href;
const imageUrl = new URL(ogImage, site.url).href;
const schemas = Array.isArray(schema) ? schema : schema ? [schema] : [];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101113" />
    <meta name="generator" content={Astro.generator} />
    <link
      rel="preload"
      href="/fonts/manrope-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/space-grotesk-latin-variable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonicalUrl} />
    <link
      rel="icon"
      href="/images/resource/ON_BJORN_ISO.png"
      type="image/png"
    />
    <link rel="apple-touch-icon" href="/images/resource/ON_BJORN_ISO.png" />
    <title>{title}</title>
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={imageUrl} />
    <meta
      property="og:image:alt"
      content="ON BJORN — Soluciones digitales a medida"
    />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {
      schemas.map((item) => (
        <script
          type="application/ld+json"
          set:html={JSON.stringify(item).replace(/</g, "\\u003c")}
        />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main-content">Ir al contenido principal</a>
    <Header />
    <main id="main-content"><slot /></main>
    <Footer />
    <script>
      import "../scripts/scroll";
    </script>
  </body>
</html>
