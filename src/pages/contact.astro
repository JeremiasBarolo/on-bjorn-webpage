---
import Layout from "../layouts/Layout.astro";
import Preguntas from "../components/inicio/Preguntas.astro";
import { site } from "../data/site";
---

<Layout
  title="Contacto — Contanos tu proyecto | ON BJORN"
  description="Contanos qué necesitás resolver. Contactá a ON BJORN por WhatsApp o email para evaluar tu proyecto y preparar una propuesta a medida."
  schema={{
    "@context": "https://schema.org",
    "@type": "ContactPage",
    name: "Contacto ON BJORN",
    url: site.url + "/contact",
  }}
>
  <section class="section shell page-intro">
    <p class="eyebrow">HABLEMOS DE TU PROYECTO</p><div class="contact-grid">
      <div>
        <h1 class="page-title" data-reveal>
          Contanos qué<br />querés resolver<span class="blue-dot">.</span>
        </h1><p class="page-lead">
          Una idea, una necesidad o algo que hoy te lleva demasiado tiempo.
          Contanos y evaluamos cómo podemos ayudarte.
        </p>
      </div><div class="contact-channels" data-reveal>
        <div>
          <p class="eyebrow">EMPECEMOS UNA CONVERSACIÓN</p><a
            class="button"
            href={site.whatsapp}>Escribinos por WhatsApp ↗</a
          ><p>{site.phone}</p>
        </div><div>
          <p class="eyebrow">TAMBIÉN POR EMAIL</p><a
            class="text-link"
            href={"mailto:" + site.email}>{site.email}</a>
        </div><div>
          <p class="eyebrow">ENCONTRANOS EN</p><a
            class="text-link"
            href={site.instagram}
            target="_blank"
            rel="noopener noreferrer">Instagram ↗</a
          ><a
            class="text-link"
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer">LinkedIn ↗</a
          ><p>Buenos Aires, Argentina</p>
        </div>
      </div>
    </div>
  </section>
  <Preguntas />
</Layout>
