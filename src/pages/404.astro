---
import Layout from "../layouts/Layout.astro";
import { site } from "../data/site";
---

<Layout title="Página no encontrada | ON BJORN" noindex={true}
  ><section class="section shell error-page">
    <p class="eyebrow">PÁGINA NO ENCONTRADA</p><div
      class="error-number"
      aria-hidden="true"
    >
      404<span class="blue-dot">.</span>
    </div><h1>Este camino no lleva a una página.</h1><p>
      Podés volver al inicio o escribirnos para hablar de tu proyecto.
    </p><div class="hero-actions">
      <a class="button" href="/">Volver al inicio ↗</a><a
        class="text-link"
        href={site.whatsapp}>Hablemos por WhatsApp ↗</a>
    </div>
  </section></Layout
>
