---
import Layout from "../layouts/Layout.astro";
import Presentacion from "../components/inicio/Presentacion.astro";
import Proyectos from "../components/inicio/Proyectos.astro";
import Experiencia from "../components/inicio/Experiencia.astro";
import Servicios from "../components/inicio/Servicios.astro";
import Proceso from "../components/inicio/Proceso.astro";
import Preguntas from "../components/inicio/Preguntas.astro";
import Contacto from "../components/shared/Contacto.astro";
import { faqs } from "../data/faqs";
import { site } from "../data/site";
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ProfessionalService",
    "@id": site.url + "/#organization",
    name: site.name,
    url: site.url,
    description: site.description,
    logo: site.url + "/images/resource/ON_BJORN_ISO.png",
    telephone: site.phone,
    email: site.email,
    address: {
      "@type": "PostalAddress",
      addressLocality: "Buenos Aires",
      addressCountry: "AR",
    },
    sameAs: [site.instagram, site.linkedin, site.github],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: site.name,
    url: site.url,
    inLanguage: "es-AR",
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((faq) => ({
      "@type": "Question",
      name: faq.pregunta,
      acceptedAnswer: { "@type": "Answer", text: faq.respuestaTexto },
    })),
  },
];
---

<Layout schema={schema}
  ><Presentacion /><Proyectos /><Experiencia /><Servicios /><Proceso
  /><Preguntas /><Contacto /></Layout
>
