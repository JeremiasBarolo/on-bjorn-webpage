---
import Layout from "../layouts/Layout.astro";
import Experiencia from "../components/inicio/Experiencia.astro";
import Proceso from "../components/inicio/Proceso.astro";
import Contacto from "../components/shared/Contacto.astro";
import { site } from "../data/site";
---

<Layout
  title="Sobre ON BJORN — Desarrollo y soluciones digitales"
  description="Conocé el enfoque de ON BJORN: entender tu negocio y crear soluciones digitales a medida, desde una web hasta software, automatizaciones e inteligencia artificial."
  schema={{
    "@context": "https://schema.org",
    "@type": "AboutPage",
    name: "Sobre ON BJORN",
    url: site.url + "/about",
  }}
>
  <section class="section page-intro shell">
    <p class="eyebrow">SOBRE ON BJORN</p><h1 class="page-title" data-reveal>
      La tecnología empieza<br />por entender tu negocio<span class="blue-dot"
        >.</span>
    </h1><p class="page-lead">
      Creamos soluciones digitales a medida para empresas que necesitan
      presentar lo que hacen, organizar su operación o conectar sus
      herramientas.
    </p>
  </section>
  <section class="section theme-light">
    <div class="shell">
      <p class="eyebrow section-rule">UN ENFOQUE A MEDIDA</p><div
        class="section-intro"
        data-reveal
      >
        <h2 class="display-title">
          Una necesidad.<br />Una solución propia.
        </h2><div>
          <p>
            Una web, una tienda online, software interno o un proceso que se
            puede automatizar. El punto de partida es lo que tu negocio necesita
            resolver.
          </p><p>
            Definimos el alcance, los entregables y las herramientas para cada
            proyecto. Cuando hace falta branding o diseño, coordinamos ese
            trabajo con agencias y profesionales independientes y podemos
            incluirlo en la misma propuesta.
          </p><a class="text-link" href="/#services"
            >Explorá los servicios ↗</a>
        </div>
      </div>
    </div>
  </section>
  <Experiencia /><Proceso /><Contacto />
</Layout>
