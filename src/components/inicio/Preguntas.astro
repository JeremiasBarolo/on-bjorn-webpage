---
import { faqs } from "../../data/faqs";
---

<section class="section theme-light" aria-labelledby="faq-heading">
  <div class="shell faq-grid">
    <div data-reveal>
      <p class="eyebrow">PREGUNTAS FRECUENTES</p><h2
        id="faq-heading"
        class="display-title"
      >
        Antes<br />de empezar.
      </h2>
    </div><div class="faq-list">
      {
        faqs.map((faq, i) => (
          <details name="faqs" open={i === 0}>
            <>
              <summary>
                <>
                  <h3>{faq.pregunta}</h3>
                  <span class="disclosure-mark" aria-hidden="true">
                    +
                  </span>
                </>
              </summary>
              <p>{faq.respuestaTexto}</p>
            </>
          </details>
        ))
      }
    </div>
  </div>
</section>
