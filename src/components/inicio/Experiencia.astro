---
import ProjectShowcase from "../shared/ProjectShowcase.astro";
import marcaDesktop from "../../assets/projects/marca-desktop.jpg";
import marcaMobile from "../../assets/projects/marca-mobile.jpg";
import marcaDetail from "../../assets/projects/marca-detail.jpg";
import riesgoDesktop from "../../assets/projects/riesgo-desktop.jpg";
import riesgoMobile from "../../assets/projects/riesgo-mobile.jpg";
import riesgoDetail from "../../assets/projects/riesgo-graph.svg";
import { site } from "../../data/site";
const platforms = [
  {
    id: "marca",
    name: "Marca Latam",
    domain: "marcalatam.com",
    desktop: marcaDesktop,
    mobile: marcaMobile,
    detail: marcaDetail,
    detailLabel: "Funcionalidades",
    category: "REGISTRO Y SEGUIMIENTO DE MARCAS",
    description:
      "Una plataforma que reúne la búsqueda de marcas, la solicitud de registro y el seguimiento del trámite en Paraguay.",
    features: [
      "Búsqueda de marcas",
      "Seguimiento del trámite",
      "Documentación y avisos",
    ],
    url: "https://marcalatam.com/",
  },
  {
    id: "riesgo",
    name: "Riesgo Red",
    domain: "riesgo.red",
    desktop: riesgoDesktop,
    mobile: riesgoMobile,
    detail: riesgoDetail,
    detailLabel: "Red de vínculos",
    category: "INVESTIGACIÓN EN FUENTES ABIERTAS",
    description:
      "Información sobre personas y empresas, organizada en vínculos e informes que permiten volver a las fuentes citadas.",
    features: ["Fuentes abiertas", "Red de vínculos", "Informes con fuentes"],
    url: "https://www.riesgo.red/",
  },
] as const;
---

<section class="section theme-dark" aria-labelledby="experience-heading">
  <div class="shell">
    <p class="eyebrow section-rule">EXPERIENCIA EN OTRAS PLATAFORMAS</p>
    <div class="section-intro" data-reveal>
      <h2 id="experience-heading" class="display-title">
        Experiencia detrás<br />de ON BJORN.
      </h2><p>
        Además de los proyectos propios de ON BJORN, también participo como
        desarrollador principal en estas plataformas a través de <a
          class="text-link"
          href={site.cuos}
          target="_blank"
          rel="noopener noreferrer">CUOS ↗</a
        >.
      </p>
    </div>
    <div class="experience-grid">
      {
        platforms.map((platform) => (
          <article class="platform">
            <p class="platform-category">{platform.category}</p>
            <ProjectShowcase
              id={`gallery-${platform.id}`}
              title={platform.name}
              domain={platform.domain}
              tone={platform.id}
              desktop={platform.desktop}
              mobile={platform.mobile}
              detail={platform.detail}
              detailLabel={platform.detailLabel}
              compact
            />
            <p class="eyebrow platform-role">
              A TRAVÉS DE CUOS · DESARROLLADOR PRINCIPAL
            </p>
            <div class="platform-heading">
              <>
                <h3>{platform.name}</h3>
                <a
                  href={platform.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`Visitar ${platform.name}`}
                  class="round-link"
                >
                  ↗
                </a>
              </>
            </div>
            <>
              <p class="platform-description">{platform.description}</p>
              <ul
                class="platform-features"
                aria-label={`Funciones de ${platform.name}`}
              >
                {platform.features.map((feature) => (
                  <li>{feature}</li>
                ))}
              </ul>
            </>
          </article>
        ))
      }
    </div>
  </div>
</section>
