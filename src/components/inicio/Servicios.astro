---
import { services } from "../../data/services";
import { site } from "../../data/site";
---

<section
  id="services"
  class="section theme-light"
  aria-labelledby="services-heading"
>
  <div class="shell">
    <p class="eyebrow section-rule">QUÉ PODEMOS HACER</p><div
      class="section-intro"
      data-reveal
    >
      <h2 id="services-heading" class="display-title">
        Tu negocio,<br />el punto de partida.
      </h2><p>
        Contanos qué necesitás resolver. Proponemos la combinación de
        desarrollo, diseño, automatización e inteligencia artificial que tenga
        sentido para tu proyecto.
      </p>
    </div>
    <div class="service-list">
      {
        services.map((service, i) => (
          <details name="services" open={i === 0} class="service">
            <>
              <summary>
                <>
                  <span class="row-number">0{i + 1}</span>
                  <h3>{service.title}</h3>
                  <span class="service-purpose">{service.purpose}</span>
                  <span class="disclosure-mark" aria-hidden="true">
                    +
                  </span>
                </>
              </summary>
              <div class="service-body">
                <p class="service-description">{service.description}</p>
                <ul class="tags">
                  {service.examples.map((example) => (
                    <li>{example}</li>
                  ))}
                </ul>
                {service.scope && <p class="scope-note">{service.scope}</p>}
              </div>
            </>
          </details>
        ))
      }
    </div>
    <div class="open-project">
      <div>
        <h3>¿Tu proyecto es diferente?</h3><p>
          Contanos qué necesitás resolver. Evaluamos la viabilidad y el alcance.
        </p>
      </div><a class="button" href={site.whatsapp}
        >Conversemos <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</section>
