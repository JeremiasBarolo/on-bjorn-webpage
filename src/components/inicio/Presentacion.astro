---
import { site } from "../../data/site";
import LogoScene from "../shared/LogoScene.astro";
---

<section class="hero shell" aria-labelledby="hero-heading">
  <div class="hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">SOLUCIONES DIGITALES A MEDIDA</p><h1 id="hero-heading">
        Tu próximo paso<br />digital, a medida.
      </h1><p class="hero-description">
        Desarrollamos webs, software, automatizaciones y soluciones con
        inteligencia artificial a medida de tu negocio.
      </p><div class="hero-actions">
        <a class="button" href={site.whatsapp}
          >Contanos tu proyecto <span aria-hidden="true">↗</span></a
        ><a class="text-link" href="#projects"
          >Ver nuestro trabajo <span aria-hidden="true">↓</span></a>
      </div>
    </div><LogoScene />
  </div>
  <div class="hero-wordmark" aria-hidden="true">ON BJORN</div>
</section>
