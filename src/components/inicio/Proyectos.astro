---
import ProjectShowcase from "../shared/ProjectShowcase.astro";
import desktop from "../../assets/projects/gbl-desktop.jpg";
import mobile from "../../assets/projects/gbl-mobile.jpg";
import detail from "../../assets/projects/gbl-detail.jpg";
---

<section
  id="projects"
  class="section theme-light"
  aria-labelledby="projects-heading"
>
  <div class="shell">
    <p class="eyebrow section-rule">PROYECTO DESTACADO · ON BJORN</p>
    <div class="project-heading" data-reveal>
      <div>
        <p class="case-category">Web empresarial / Ingeniería estructural</p><h2
          id="projects-heading"
          class="display-title"
        >
          GBL-Ingeniería<span class="blue-dot">.</span>
        </h2>
      </div><a
        class="text-link"
        href="https://gblingenieria.com.ar/"
        target="_blank"
        rel="noopener noreferrer"
        >Ver sitio en vivo <span aria-hidden="true">↗</span></a>
    </div>
    <ProjectShowcase
      id="gallery-gbl"
      title="GBL Ingeniería"
      domain="gblingenieria.com.ar"
      tone="gbl"
      desktop={desktop}
      mobile={mobile}
      detail={detail}
      detailLabel="Portfolio de obras"
    />
    <div class="project-caption" data-reveal>
      <h3>Una web a la altura<br />de su ingeniería.</h3><p>
        Un sitio para presentar al estudio, dar lugar a su trabajo técnico y
        hacer más simple el primer contacto. La experiencia reúne la
        presentación institucional, el portfolio de obras y los canales de
        consulta.
      </p>
    </div>
    <dl class="case-scope" data-reveal>
      <div>
        <dt>Presentación</dt><dd>
          Identidad del estudio, especialidad y propuesta de trabajo.
        </dd>
      </div><div>
        <dt>Proyectos</dt><dd>
          Obras, imágenes y fichas para recorrer su experiencia.
        </dd>
      </div><div>
        <dt>Contacto</dt><dd>
          Canales de consulta y acceso a la ubicación en Google Maps.
        </dd>
      </div>
    </dl>
    <ul class="tags" aria-label="Alcance del proyecto">
      <li>Web empresarial</li><li>Desarrollo y publicación</li><li>
        Google Maps
      </li>
    </ul>
  </div>
</section>
