---
import { site } from "../../data/site";
---

<section
  class="section theme-dark contact-section"
  aria-labelledby="contact-heading"
>
  <div class="shell">
    <p class="eyebrow section-rule">HABLEMOS DE TU PROYECTO</p><div
      class="contact-grid"
    >
      <h2 id="contact-heading" class="display-title" data-reveal>
        Contanos qué<br />querés resolver<span class="blue-dot">.</span>
      </h2><div class="contact-copy" data-reveal>
        <p>
          Una idea, una necesidad o algo que hoy te lleva demasiado tiempo.
          Contanos y evaluamos cómo podemos ayudarte.
        </p><a class="button" href={site.whatsapp}
          >Escribinos por WhatsApp <span aria-hidden="true">↗</span></a
        ><p class="email-alternative">
          ¿Preferís escribir un mail?<br /><a
            class="text-link"
            href={"mailto:" + site.email}>{site.email}</a>
        </p>
      </div>
    </div>
  </div>
</section>
