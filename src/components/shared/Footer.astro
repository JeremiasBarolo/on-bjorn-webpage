---
import { site } from "../../data/site";
---

<footer class="site-footer shell">
  <div class="footer-top">
    <a class="brand-link" href="/" aria-label="ON BJORN, inicio"
      ><img
        src="/images/resource/marca-de-agua.png"
        alt="ON BJORN"
        width="374"
        height="68"
        loading="lazy"
      /></a
    ><nav aria-label="Al pie">
      <a href="/about">Sobre ON BJORN</a><a
        href={site.instagram}
        target="_blank"
        rel="noopener noreferrer">Instagram ↗</a
      ><a href={site.linkedin} target="_blank" rel="noopener noreferrer"
        >LinkedIn ↗</a>
    </nav>
  </div>
  <div class="footer-bottom">
    <span>© {new Date().getFullYear()} ON BJORN</span><span
      >Buenos Aires, Argentina</span
    ><a href="/contact">Contacto</a>
  </div>
</footer>
